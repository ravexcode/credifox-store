generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         String   @id @default(uuid())
  name       String
  type       String
  cost       Int
  values     Json
  images_url String[]
  variations String[]
}

model User {
  id         String   @id @default(uuid())
  tag        String   @unique
  uploaded   Json[]
  name       String
  password   String
  created_at DateTime @default(now())
  orders     Order[]
}

model Storaged {
  id         String   @id @default(uuid())
  name       String
  price      Int
  stock      Int?
  image_url  String?
  created_at DateTime @default(now())
}

model Order {
  id             String      @id @default(uuid())
  user_id        String
  user           User        @relation(fields: [user_id], references: [id])
  status         String      @default("pending")
  payment_status String      @default("unpaid")
  total          Int
  items          OrderItem[]
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
}

model OrderItem {
  id         String  @id @default(uuid())
  order_id   String
  order      Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id String?
  name       String
  price      Int
  qty        Int
  variation  String?
  image_url  String?
}
